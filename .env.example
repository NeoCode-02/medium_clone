# -------------------------
# APP SETTINGS
# -------------------------
APP_NAME=MediumClone
APP_ENV=development
SERVER_HOST=http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------
# DATABASE CONFIG
# -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1105
POSTGRES_DB=medium_clone
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -------------------------
# REDIS / CELERY CONFIG
# -------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -------------------------
# JWT & AUTH SETTINGS
# -------------------------
JWT_SECRET_KEY="hWwLEmbW]1[}77"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------
# AWS / S3 CONFIG
# -------------------------
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=medium-clone-bucket
AWS_S3_ENDPOINT=https://s3.${AWS_REGION}.amazonaws.com

# -------------------------
# EMAIL (Optional, if using SES or SMTP)
# -------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=yourpassword
MAIL_FROM=youremail@gmail.com
MAIL_FROM_NAME=Medium Clone

# -------------------------
# LOGGING
# -------------------------
LOG_LEVEL=info

# -------------------------
# CORS
# -------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
